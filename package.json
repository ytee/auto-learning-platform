{
  "name": "auto-learning-platform",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:concepts": "node scripts/build-concepts.mjs",
    "check:concepts": "node scripts/build-concepts.mjs --check",
    "render:concept": "node scripts/render-concept-source.mjs",
    "validate:schemas": "node scripts/validate-schema-contracts.mjs",
    "validate": "npm run build:concepts && node scripts/validate-content.mjs && node scripts/validate-concepts-ui.mjs && npm run validate:schemas"
  }
}
