{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ytee/auto-learning-platform/main/schemas/v1/concept-collection.schema.json",
  "title": "AutoLeaP Concept Collection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "module", "collection", "standardBaseline", "generatedFrom", "concepts"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "module": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1}
      }
    },
    "standardBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "edition", "status"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "edition": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1}
      }
    },
    "generatedFrom": {"type": "string", "minLength": 1},
    "concepts": {"type": "array", "items": {"$ref": "concept.schema.json"}, "minItems": 1}
  }
}
