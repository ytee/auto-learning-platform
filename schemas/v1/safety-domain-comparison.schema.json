{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ytee/auto-learning-platform/main/schemas/v1/safety-domain-comparison.schema.json",
  "title": "AutoLeaP Safety Domain Comparison v1",
  "description": "A structured comparison between two safety-critical engineering domains.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "eyebrow",
    "summary",
    "caution",
    "verifiedOn",
    "sharedPrinciples",
    "differences",
    "mappings",
    "engineControlExample",
    "transfer",
    "learningRoute",
    "references"
  ],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "eyebrow": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "caution": {"type": "string", "minLength": 1},
    "verifiedOn": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "sharedPrinciples": {
      "type": "array",
      "minItems": 6,
      "items": {"$ref": "#/$defs/titledSummary"}
    },
    "differences": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "automotive", "aerospace", "practicalEffect"],
        "properties": {
          "dimension": {"type": "string", "minLength": 1},
          "automotive": {"type": "string", "minLength": 1},
          "aerospace": {"type": "string", "minLength": 1},
          "practicalEffect": {"type": "string", "minLength": 1}
        }
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["automotive", "aerospace", "note"],
        "properties": {
          "automotive": {"type": "string", "minLength": 1},
          "aerospace": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "engineControlExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automotive", "aerospace", "lesson"],
      "properties": {
        "automotive": {"$ref": "#/$defs/domainExample"},
        "aerospace": {"$ref": "#/$defs/domainExample"},
        "lesson": {"type": "string", "minLength": 1}
      }
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shared", "automotiveSpecific", "aerospaceSpecific"],
      "properties": {
        "shared": {"$ref": "#/$defs/stringList"},
        "automotiveSpecific": {"$ref": "#/$defs/stringList"},
        "aerospaceSpecific": {"$ref": "#/$defs/stringList"}
      }
    },
    "learningRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sharedFoundation", "automotiveBranch", "aerospaceBranch"],
      "properties": {
        "sharedFoundation": {"$ref": "#/$defs/stringList"},
        "automotiveBranch": {"$ref": "#/$defs/stringList"},
        "aerospaceBranch": {"$ref": "#/$defs/stringList"}
      }
    },
    "references": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "organization", "url", "note"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "organization": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "titledSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "domainExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "hazardContext", "assessment", "assuranceFocus"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "hazardContext": {"type": "string", "minLength": 1},
        "assessment": {"type": "string", "minLength": 1},
        "assuranceFocus": {"type": "string", "minLength": 1}
      }
    },
    "stringList": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
