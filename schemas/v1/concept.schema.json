{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ytee/auto-learning-platform/main/schemas/v1/concept.schema.json",
  "title": "AutoLeaP Runtime Concept v1",
  "description": "Normalized concept record generated from canonical source content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "module",
    "collection",
    "order",
    "standard",
    "difficulty",
    "stage",
    "systems",
    "summary",
    "learningObjectives",
    "explanation",
    "whyItMatters",
    "inputs",
    "activities",
    "outputs",
    "automotiveExample",
    "commonMistakes",
    "relatedConcepts",
    "linkedQuestions",
    "references",
    "source"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "module": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "collection": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "order": {"type": "integer", "minimum": 1},
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "edition", "parts", "clauseRefs"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "edition": {"type": "string", "minLength": 1},
        "parts": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "clauseRefs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
      }
    },
    "difficulty": {"type": "string", "enum": ["Foundation", "Intermediate", "Advanced", "Expert"]},
    "stage": {"type": "integer", "minimum": 1, "maximum": 10},
    "systems": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "summary": {"type": "string", "minLength": 1},
    "learningObjectives": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "explanation": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "whyItMatters": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "activities": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "outputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "automotiveExample": {"type": "string", "minLength": 1},
    "commonMistakes": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "relatedConcepts": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "minItems": 1, "uniqueItems": true},
    "linkedQuestions": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"}, "minItems": 1, "uniqueItems": true},
    "references": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "source": {"type": "string", "minLength": 1}
  }
}
