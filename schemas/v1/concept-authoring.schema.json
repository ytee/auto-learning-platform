{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ytee/auto-learning-platform/main/schemas/v1/concept-authoring.schema.json",
  "title": "AutoLeaP Concept Authoring Document v1",
  "description": "Generation interchange format rendered into canonical AutoLeaP concept source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentType",
    "metadata",
    "sections"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "contentType": {
      "type": "string",
      "const": "concept"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "module",
        "collection",
        "order",
        "standard",
        "difficulty",
        "stage",
        "systems",
        "relatedConcepts",
        "linkedQuestions",
        "references"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "module": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "collection": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "standard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "family",
            "edition",
            "parts",
            "clauseRefs"
          ],
          "properties": {
            "family": {
              "type": "string",
              "minLength": 1
            },
            "edition": {
              "type": "string",
              "minLength": 1
            },
            "parts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "clauseRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "Foundation",
            "Intermediate",
            "Advanced",
            "Expert"
          ]
        },
        "stage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "systems": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "relatedConcepts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "linkedQuestions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learningObjectives",
        "concept",
        "whyItMatters",
        "inputs",
        "activities",
        "outputsAndEvidence",
        "automotiveExample",
        "commonMistakes"
      ],
      "properties": {
        "learningObjectives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "concept": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "whyItMatters": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "activities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "outputsAndEvidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "automotiveExample": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "commonMistakes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
